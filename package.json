{
  "name": "music-together-desktop",
  "version": "2.2.5",
  "private": true,
  "description": "Native desktop client for Music Together",
  "debugBuild": false,
  "desktopName": "music-together-desktop",
  "author": "Music Together Contributors",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc -b && vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.electron.json --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:online": "node scripts/online-smoke.mjs",
    "smoke:electron": "node scripts/electron-smoke.mjs",
    "smoke:regressions": "node scripts/regression-smoke.mjs",
    "lint": "eslint .",
    "dist": "npm run build && electron-builder",
    "dist:win": "node scripts/build-windows.mjs --debug",
    "dist:win:release": "node scripts/build-windows.mjs",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "io.github.yueby.musictogether.desktop",
    "productName": "Music Together",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Music Together Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
